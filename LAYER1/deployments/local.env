# =============================================================================
# Live deployment addresses on the Hyperledger Besu QBFT L1 (chain 1337).
#
# Deterministic from deployer 0xf39F (anvil[0]) + sequential nonces under
# DeployL1.s.sol's deploy order:
#   nonce 0  →  Registry           0x5FbDB231…
#   nonce 1  →  Verifier           0xe7f1725E…
#   nonce 2  →  CommandLog         0x9fE46736…  
#   nonce 3  →  Registry.setVerifier (call, no new contract)
# Stable across re-deploys on a clean Besu chain.
# =============================================================================

# ── Chain ────────────────────────────────────────────────────────────────────
export URL=${URL:-http://localhost:8545}
export CHAIN_ID=1337

# ── Convoy stack (deterministic on a clean Besu chain) ──────────────────────
export REGISTRY_ADDR=0x5FbDB2315678afecb367f032d93F642f64180aa3
export CONVOY_VERIFIER_ADDR=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
export COMMAND_LOG_ADDR=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0

export COMMANDLOG_ADDR="$COMMAND_LOG_ADDR"
export GETH_RPC_URL="$URL"

# ── Keys ─────────────────────────────────────────────────────────────────────
# DEPLOYER_ADDR = the L1 owner (anvil[0]); FIXED, because the contract addresses
# above are deterministic CREATE(owner, nonce). The relay + commander signers are
# NOT fixed: script1_up.sh mints them fresh in-container every mission and exports
# COMMANDER_ADDR / ALPHA_RELAY_ADDR / BRAVO_RELAY_ADDR at runtime — so they are
# intentionally absent here. (0x7099 is now the genesis funding faucet, not a relay.)
export DEPLOYER_ADDR=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

