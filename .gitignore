# ── Secrets / environment ─────────────────────────────────────────────
.env
.env.local

# ── Per-run scratch, regenerated by the pipeline (script1_up.sh, …) ────
#   .tmp-l1           L1 verifier-deploy scratch (deploy-stark-verifier)
#   .tmp-l2           L2 deployer keystore, contract addresses, pulled proofs
#   SIMULATOR/runs    run logs
#   bootstrap/output  madara-bootstrapper Starknet-core addresses
SIMULATOR/demo/.tmp-l1/
SIMULATOR/demo/.tmp-l2/
LAYER1/bootstrap/output/

# ── Foundry (L1) build output ─────────────────────────────────────────
#   deps (forge-std, openzeppelin-contracts) are pinned git submodules
#   under lib/ — tracked via .gitmodules, NOT ignored
LAYER1/contracts_solidity/out/
LAYER1/contracts_solidity/cache/
LAYER1/contracts_solidity/broadcast/

# ── Scarb (L2 Cairo) build output ─────────────────────────────────────
#   Scarb.lock IS committed (pins resolved deps for reproducibility)
LAYER2/contracts_cairo/**/target/

# ── Rust (PROOF/submitter) build output ───────────────────────────────
PROOF/submitter/target/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── Node (future SIMULATOR webapp; package-lock.json IS committed) ─────
node_modules/

# ── Build / cache (generic) ───────────────────────────────────────────
dist/
build/
.cache/

# ── Editor / OS ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Claude Code local state (per-machine, never commit) ───────────────
.claude/

# demo-run output logs (bulky, regenerated per run; not source)
SIMULATOR/demo/runs/*/stats.log
SIMULATOR/demo/runs/*/logs/

# vendored openssl/stunnel: keep source to read (ssl/, crypto/), drop test suites & keys
# (full source preserved in the .tar.gz). Avoids GitHub push-protection on test PEM keys.
DEVOPS/vendor/alpine-3.20/src/openssl-3.3.7/test/
DEVOPS/vendor/alpine-3.20/src/openssl-3.3.7/demos/
DEVOPS/vendor/alpine-3.20/src/openssl-3.3.7/fuzz/
DEVOPS/vendor/alpine-3.20/src/**/*.pem
DEVOPS/vendor/alpine-3.20/src/**/*.key

# vendored openssl/stunnel docs embed sample PEM private keys (trips GitHub push-protection); full docs remain in the .tar.gz
DEVOPS/vendor/alpine-3.20/src/openssl-3.3.7/doc/
DEVOPS/vendor/alpine-3.20/src/stunnel-5.72/doc/

DEVOPS/.env
