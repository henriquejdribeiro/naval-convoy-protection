# ── Secrets / environment ─────────────────────────────────────────────
.env
.env.local

# ── Per-run scratch, regenerated by the pipeline (script1_up.sh, …) ────
#   .tmp-l1           L1 verifier-deploy scratch (deploy-stark-verifier)
#   .tmp-l2           L2 deployer keystore, contract addresses, pulled proofs
#   SIMULATOR/runs    run logs
#   bootstrap/output  madara-bootstrapper Starknet-core addresses
SIMULATOR/demo/.tmp-l1/
SIMULATOR/demo/.tmp-l2/
LAYER1/bootstrap/output/

# ── Foundry (L1) build output ─────────────────────────────────────────
#   deps (forge-std, openzeppelin-contracts) are pinned git submodules
#   under lib/ — tracked via .gitmodules, NOT ignored
LAYER1/contracts_solidity/out/
LAYER1/contracts_solidity/cache/
LAYER1/contracts_solidity/broadcast/

# ── Scarb (L2 Cairo) build output ─────────────────────────────────────
#   Scarb.lock IS committed (pins resolved deps for reproducibility)
LAYER2/contracts_cairo/**/target/

# ── Rust (PROOF/submitter) build output ───────────────────────────────
PROOF/submitter/target/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── Node (future SIMULATOR webapp; package-lock.json IS committed) ─────
node_modules/

# ── Build / cache (generic) ───────────────────────────────────────────
dist/
build/
.cache/

# ── Editor / OS ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Claude Code local state (per-machine, never commit) ───────────────
.claude/
